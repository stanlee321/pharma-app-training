# TivaTrainer backend settings — copy to backend/.env (gitignored) and adjust.
# Every variable is prefixed TIVA_ (see app/core/config.py). Real env vars override this file.

# Postgres from the repo-root docker-compose.yml (docker compose up -d).
# Omit to fall back to the zero-setup SQLite file ./tiva.db.
TIVA_DATABASE_URL=postgresql+psycopg://tiva:tiva@localhost:5433/tiva

# Auth: "local" (username/password -> Bearer JWT) or "gateway" (trust ms-api-gateway X-* headers).
TIVA_AUTH_MODE=local
# HS256 signing secret. REQUIRED in local mode. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server REFUSES TO START while this is empty, shorter than 32 bytes, or still the
# placeholder below — replace it before the first run.
TIVA_JWT_SECRET=replace-me-with-a-long-random-secret
TIVA_JWT_TTL_MINUTES=720

# Where NEW generated PDFs are stored: "db" (raw bytes in the document_blobs table — bytea on
# Postgres; atomic with the case, one pg_dump backs up everything) or "local" (files under
# TIVA_DOCUMENTS_DIR). Existing documents are always read from where their row says they are.
TIVA_DOCUMENT_STORAGE=db

# Root for "local" PDFs (still read for legacy file-stored rows in db mode; migration 0008 copies
# from here and its downgrade writes back here). Relative paths resolve against backend/;
# default: <repo>/backend/var/documents (gitignored).
TIVA_DOCUMENTS_DIR=var/documents

# Optional dev seed: CREATE this admin on startup if the username is free (an existing account
# is never modified — use `python -m app.cli create-admin` to reset). Never use in prod.
# TIVA_BOOTSTRAP_ADMIN_USERNAME=admin
# TIVA_BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# Tests only: run the pytest suite against Postgres instead of a temp SQLite file.
# The database name must contain "test" (the suite drops and recreates its schema).
# TIVA_TEST_DATABASE_URL=postgresql+psycopg://tiva:tiva@localhost:5433/tiva_test
